# Nmap – Important Commands

# Basic scan
nmap 192.168.1.1

# Scan specific ports
nmap -p 22,80,443 192.168.1.1

# Scan all ports
nmap -p- 192.168.1.1

# Detect service versions
nmap -sV 192.168.1.1

# Detect operating system
nmap -O 192.168.1.1

# Service + OS + scripts
nmap -A 192.168.1.1

# Discover live hosts
nmap -sn 192.168.1.0/24

# Fast scan
nmap -F 192.168.1.1

# Save results
nmap 192.168.1.1 -oN scan.txt