# 12. Operating System Detection using Nmap

# Basic OS detection
nmap -O <IP>

# OS + service detection
nmap -O -sV <IP>

# OS detection with verbose output
nmap -O -v <IP>

# Aggressive OS detection
nmap -A <IP>

# OS detection on a subnet
nmap -O 192.168.1.0/24

# OS detection without ping
nmap -O -Pn <IP>

# OS detection + default scripts
nmap -O -sC <IP>