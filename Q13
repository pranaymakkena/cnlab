# 13. NS2 Simulator – Important Commands

# i. Check NS2 installation
ns

# Run NS2 simulation
ns simulation.tcl

# Open NAM visualization
nam simulation.nam


# ii. Find Number of Packets Dropped
ns drop.tcl
grep "^d" drop.tr | wc -l


# iii. Packets Dropped by TCP/UDP
ns tcp.tcl
grep "^d" tcp.tr | wc -l

ns udp.tcl
grep "^d" udp.tr | wc -l


# iv. Packets Dropped due to Congestion
ns congestion.tcl
grep "^d" congestion.tr | wc -l


# v. Compare Data Rate & Throughput
ns throughput.tcl
grep "^r" throughput.tr | wc -l


# vi. Plot Congestion for Source/Destination
ns congestion.tcl
nam congestion.nam


# vii. Performance of Packet Transmission
ns performance.tcl

# Transmitted packets
grep "^+" performance.tr | wc -l

# Received packets
grep "^r" performance.tr | wc -l

# Dropped packets
grep "^d" performance.tr | wc -l

# Open visualization
nam performance.nam